APP_ENV=development
# Set this to the immutable image digest or Git revision used by every API/worker
# process in one deployment. Checkpoint recovery fails closed when it changes.
APP_CODE_VERSION=dev
LOG_LEVEL=INFO
# Use the DML-only runtime account here; URL-encode special characters in its password.
DATABASE_URL=mysql+asyncmy://database_alert_app:URL_ENCODED_PASSWORD@10.126.156.158:3308/archery_new?charset=utf8mb4

# Required for every /api/v1/admin/* write or settings request.
# Generate a long random value; do not reuse the model API key.
ADMIN_API_TOKEN=
RUNTIME_SETTINGS_PATH=./data/runtime-settings.json
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Model API protocol. Keep openai_compatible for Chat Completions-compatible
# providers (OpenAI, DeepSeek, internal gateways, etc.), or set openai_responses
# for the OpenAI Responses API. openai_compatible remains the default.
AI_PROVIDER=openai_compatible
# Base API root for either protocol; do not append /chat/completions or /responses.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Reasoning models can spend the provider's default 4096-token completion budget
# before emitting final content. Keep enough room for reasoning plus structured JSON.
AI_MAX_TOKENS=16384
AI_TIMEOUT_SECONDS=300
AI_JSON_MODE=true
# When the model times out or returns an invalid structure, finish with the fixed
# inconclusive result instead of inventing a cause or marking the run FAILED.
AI_FALLBACK_ENABLED=true
# Optional role-specific models. The final root-cause analysis always uses
# AI_MODEL; the main-Agent ReAct round decisions and the MCP tool inner loop may
# each use a different (lighter/faster) model. Leave empty to reuse AI_MODEL.
AI_REACT_MODEL=
AI_MCP_MODEL=
# Reasoning effort per usage point (low|medium|high|xhigh|max). Empty means the
# parameter is not sent and the provider default applies. Tip: a low effort for
# ReAct decisions and the MCP loop shortens each round; keep a high effort for
# the final analysis.
AI_REACT_REASONING_EFFORT=
AI_REASONING_EFFORT=
AI_MCP_REASONING_EFFORT=
# Required deployment baseline. Persist and display each main-Agent reasoning
# delta as it arrives. Keep false to record one complete reasoning event after
# each model call instead. The Agent settings page may override it at runtime.
STREAM_MAIN_AGENT_REASONING=false

ENVIRONMENT_ALIASES={"production":["prod","prd","production","生产","生产环境"],"staging":["staging","pre","预发"],"test":["test","t1","qa","测试"],"development":["dev","development","开发"]}

# FlashDuty is ingested exclusively by read-only Open API polling. The APP Key is sent
# only to the fixed official endpoint and is never exposed by the admin settings API.
# Query/diagnose operations are POST requests in FlashDuty even though they do not mutate data.
FLASHDUTY_ENABLED=false
FLASHDUTY_BASE_URL=https://api.flashcat.cloud
FLASHDUTY_APP_KEY=
# FlashDuty documents at least 35 seconds for long-running diagnose/tool calls.
FLASHDUTY_TIMEOUT_SECONDS=40
FLASHDUTY_MAX_RETRIES=2
FLASHDUTY_CONTEXT_ITEM_LIMIT=20
# `/alert/list` polling. The interval cannot be below five minutes; the overlapping
# lookback tolerates delayed API calls, retries, and short outages. It must be at
# least as large as the interval. When FlashDuty polling is enabled,
# FLASHDUTY_POLL_CHANNEL_IDS must contain at least one ID.
FLASHDUTY_POLLING_ENABLED=false
FLASHDUTY_POLL_INTERVAL_SECONDS=300
FLASHDUTY_POLL_LOOKBACK_SECONDS=900
# Required JSON array (or comma-separated integers) of FlashDuty collaboration-space IDs.
FLASHDUTY_POLL_CHANNEL_IDS=[123456789]
# Optional JSON array (or comma-separated integers) limiting the upstream integrations.
FLASHDUTY_POLL_INTEGRATION_IDS=[]
# Optional FlashDuty context capabilities. Enable only when the scoped
# collaboration spaces expose the corresponding data.
FLASHDUTY_CHANGES_ENABLED=false
FLASHDUTY_MONITORS_ENABLED=false
# Bind these only after /monit/datasource/list confirms the data sources exist.
FLASHDUTY_METRICS_DS_NAME=
FLASHDUTY_LOGS_DS_NAME=
FLASHDUTY_LOGS_DS_TYPE=loki

# Optional Archery MCP live evidence for alerts that need slow-query log evidence.
# The MCP catalog resolves URL/token references at the connection boundary. Tool
# authorization belongs to the key issued by the MCP service. The application
# forwards model arguments according to the remote tool Schema.
# The checked-in catalog chooses the header name; its value is resolved from .env
# and is never written into the JSON file.
# Instance and database targets are derived from each normalized alert via MCP discovery.
MCP_SETTINGS_PATH=./config/mcp/settings.json
ARCHERY_MCP_URL=
ARCHERY_MCP_TOKEN=
ARCHERY_SLOW_LOG_WINDOW_SECONDS=300
ARCHERY_MCP_TIMEOUT_SECONDS=60
# The Host returns partial enrichment before the outer tool deadline.
ARCHERY_INVESTIGATION_BUDGET_SECONDS=150
ARCHERY_MCP_TOOL_TIMEOUT_SECONDS=180

# Optional Prometheus monitoring MCP. The checked-in catalog uses
# streamable_http; every MCP may instead declare sse in config/mcp/settings.json.
# The prompt workflow uses the MCP's current target, series, label, or metadata
# capabilities to map the database before querying its five-minute alert window.
# This template contains placeholders only; do not commit real endpoint URLs or keys.
# Authentication is optional: leave both key fields empty when no header is required.
# Otherwise set the header name/value, e.g. Authorization / Bearer <token>.
PROMETHEUS_MCP_URL=
PROMETHEUS_MCP_API_KEY_HEADER=
PROMETHEUS_MCP_API_KEY=
PROMETHEUS_MCP_TIMEOUT_SECONDS=60
PROMETHEUS_INVESTIGATION_BUDGET_SECONDS=180
PROMETHEUS_MCP_TOOL_TIMEOUT_SECONDS=780

# WeCom group robot URLs are send-only: every final AI result is posted as a
# template card. The actions open dedicated lightweight pages inside the WeCom
# client. Use an HTTPS origin reachable from operator devices.
WECOM_ENABLED=false
WECOM_WEBHOOK_URL=
WECOM_PAGE_BASE_URL=http://localhost:3000

# Optional external knowledge API (KnowledgePack / LangChain + Chroma).
# The URL must be reachable from the API and Worker deployment network.
EXTERNAL_KNOWLEDGE_BASE_URL=http://knowledge:8000
# Must match KNOWLEDGE_API_KEY in the KnowledgePack deployment.
EXTERNAL_KNOWLEDGE_API_KEY=replace-with-the-same-long-random-secret
EXTERNAL_KNOWLEDGE_TIMEOUT_SECONDS=30
EXTERNAL_KNOWLEDGE_LIMIT=5
# Relevance is clamp(1 - cosine_distance, 0, 1).
EXTERNAL_KNOWLEDGE_MIN_RELEVANCE=0.60

# Selectable knowledge sources for alert matching. Empty is valid. Use a
# comma-separated value or JSON array. Currently supported: external_knowledge.
KNOWLEDGE_SOURCES=["external_knowledge"]

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# Compose provisions this least-privilege ACL user. Managed Redis may provide
# a different username.
REDIS_USERNAME=database-alert-agent
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_STREAM_NAME={database-alert-agent}:jobs
REDIS_DLQ_STREAM_NAME={database-alert-agent}:dlq
REDIS_CONSUMER_GROUP=database-alert-agent
REDIS_MAX_RETRIES=3
# Must be greater than or equal to INVESTIGATION_LEASE_SECONDS.
REDIS_CLAIM_IDLE_SECONDS=660
REDIS_DLQ_MAXLEN=10000

# Optional automatic-analysis admission policy. When enabled, alerts whose
# normalized severity appears in this list are stored as FILTERED without
# analysis or WeCom notification. JSON arrays and comma-separated values work.
ALERT_ANALYSIS_FILTER_ENABLED=false
ALERT_ANALYSIS_FILTER_SEVERITIES=["INFO"]

# HTTP accepts quickly and schedules investigation in the background.
# Use in_memory locally, redis in a multi-process deployment, or manual in tests.
HTTP_SCHEDULER=in_memory
# Maximum alerts analyzed concurrently by each API/Redis worker process.
SCHEDULER_WORKERS=1
INVESTIGATION_LEASE_SECONDS=600
# The only round limit is the main Agent ReAct loop (1-100). One round chooses
# one outer tool or finish; MCP-internal authentication/discovery calls do not
# consume additional ReAct rounds. The full analysis also has a wall-clock
# deadline and may be cancelled explicitly through the run API.
REACT_MAX_ROUNDS=8
ANALYSIS_TIMEOUT_SECONDS=1800
# Alert records are evaluated for cleanup only every Friday at 12:00
# Asia/Shanghai; the service never cleans data during startup. Expired COMPLETED,
# INCONCLUSIVE, FAILED, FILTERED, and CANCELLED alerts are eligible for cleanup.
ALERT_RETENTION_ENABLED=true
ALERT_RETENTION_DAYS=7
