APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/alerts.db

# Required for every /api/v1/admin/* write or settings request.
# Generate a long random value; do not reuse the model API key.
ADMIN_API_TOKEN=
RUNTIME_SETTINGS_PATH=./data/runtime-settings.json
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Real OpenAI-compatible model (OpenAI, DeepSeek, an internal gateway, etc.)
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Reasoning models can spend the provider's default 4096-token completion budget
# before emitting final content. Keep enough room for reasoning plus structured JSON.
AI_MAX_TOKENS=16384
AI_TIMEOUT_SECONDS=300
AI_MAX_RETRIES=2
AI_JSON_MODE=true
# When the model times out or returns an invalid structure, finish with a bounded
# candidate recommendation and REVIEW_REQUIRED instead of marking the run FAILED.
AI_FALLBACK_ENABLED=true

RUNBOOK_PDF_DIR=./runbooks/pdfs
RUNBOOK_LIMIT=5
# PDFs are loaded directly from this local directory. They must be unencrypted and
# contain a searchable text layer; scanned/image-only files require OCR beforehand.
RUNBOOK_PDF_MAX_FILE_BYTES=20000000
RUNBOOK_PDF_MAX_TEXT_CHARS=200000
RUNBOOK_MATCH_MIN_SCORE=12
RUNBOOK_MATCH_MIN_CONFIDENCE=0.35
ENVIRONMENT_ALIASES={"production":["prod","prd","production","生产","生产环境"],"staging":["staging","pre","预发"],"test":["test","t1","qa","测试"],"development":["dev","development","开发"]}

# FlashDuty is ingested exclusively by read-only Open API polling. The APP Key is sent
# only to the fixed official endpoint and is never exposed by the admin settings API.
# Query/diagnose operations are POST requests in FlashDuty even though they do not mutate data.
FLASHDUTY_ENABLED=false
FLASHDUTY_BASE_URL=https://api.flashcat.cloud
FLASHDUTY_APP_KEY=
# FlashDuty documents at least 35 seconds for long-running diagnose/tool calls.
FLASHDUTY_TIMEOUT_SECONDS=40
FLASHDUTY_MAX_RETRIES=2
FLASHDUTY_CONTEXT_ITEM_LIMIT=20
# `/alert/list` polling. The interval cannot be below five minutes; the overlapping
# lookback tolerates delayed API calls, retries, and short outages. When FlashDuty
# polling is enabled, FLASHDUTY_POLL_CHANNEL_IDS must contain at least one ID.
FLASHDUTY_POLLING_ENABLED=false
FLASHDUTY_POLL_INTERVAL_SECONDS=300
FLASHDUTY_POLL_LOOKBACK_SECONDS=900
# Required JSON array (or comma-separated integers) of FlashDuty collaboration-space IDs.
FLASHDUTY_POLL_CHANNEL_IDS=[123456789]
# Optional JSON array (or comma-separated integers) limiting the upstream integrations.
FLASHDUTY_POLL_INTEGRATION_IDS=[]
# Capability gates are intentionally opt-in. Enable them only after a read-only
# audit confirms that the scoped deployment returns changes or Monitors data.
FLASHDUTY_CHANGES_ENABLED=false
FLASHDUTY_MONITORS_ENABLED=false
# Bind these only after /monit/datasource/list confirms the data sources exist.
FLASHDUTY_METRICS_DS_NAME=
FLASHDUTY_LOGS_DS_NAME=
FLASHDUTY_LOGS_DS_TYPE=loki

# Optional Archery MCP live evidence for titles containing the slow_query identifier.
# Use the full Streamable HTTP endpoint (normally ending in /mcp). The token is
# sent only as X-Archery-Token. The MCP instance/database scope is deployment
# configuration rather than source-code constants. The slow-log query filters
# f_insert_time over the five minutes ending at alert.occurred_at.
ARCHERY_MCP_URL=
ARCHERY_MCP_TOKEN=
ARCHERY_MCP_INSTANCE_REF=archery
ARCHERY_MCP_DB_NAME=archery
ARCHERY_SLOW_LOG_WINDOW_SECONDS=300
ARCHERY_MCP_TIMEOUT_SECONDS=60

# WeCom group robot URLs are send-only: every final AI result is posted to the group.
# The URL is treated as a credential. Set WECOM_ENABLED=true to enable notifications;
# when false, no messages are sent even if a webhook URL is configured.
WECOM_ENABLED=false
WECOM_WEBHOOK_URL=

# Optional external knowledge API (KnowledgePack / LangChain + Chroma).
# Both Compose projects must join this pre-created external Docker network.
KNOWLEDGE_NETWORK_NAME=database-alert-knowledge
# "knowledge" is the network alias exported by the KnowledgePack Compose service.
EXTERNAL_KNOWLEDGE_BASE_URL=http://knowledge:8000
# Must match KNOWLEDGE_API_KEY in the KnowledgePack deployment.
EXTERNAL_KNOWLEDGE_API_KEY=replace-with-the-same-long-random-secret
EXTERNAL_KNOWLEDGE_TIMEOUT_SECONDS=30
EXTERNAL_KNOWLEDGE_MAX_RETRIES=2
EXTERNAL_KNOWLEDGE_LIMIT=5
# Relevance is clamp(1 - cosine_distance, 0, 1).
EXTERNAL_KNOWLEDGE_MIN_RELEVANCE=0.60

# Selectable knowledge sources for alert matching. Historical cases (DB) are
# always used and not controlled by this setting.  Comma-separated or JSON array.
# Allowed values: local_pdf, external_knowledge
KNOWLEDGE_SOURCES=["local_pdf","external_knowledge"]

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ALERT_TOPIC=database-alerts
KAFKA_DLQ_TOPIC=database-alerts.dlq
KAFKA_CONSUMER_GROUP=database-alert-agent
KAFKA_MAX_RETRIES=3

# HTTP accepts quickly and schedules investigation in the background.
# Use in_memory locally, kafka in a multi-process deployment, or manual in tests.
HTTP_SCHEDULER=in_memory
SCHEDULER_WORKERS=1
INVESTIGATION_LEASE_SECONDS=600
TOOL_MAX_RESULT_CHARS=12000

# Enable only after real read-only investigation tools are connected.
REACT_ENABLED=false
REACT_MAX_DYNAMIC_TURNS=2
VALIDATION_ENABLED=true
# Shadow mode always returns REVIEW_REQUIRED and is recommended while collecting labels.
SHADOW_ENABLED=true
# Set only after the versioned offline/online production gate has passed in CI.
PRODUCTION_GATE_APPROVED=false
