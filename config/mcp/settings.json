{
  "mcpServers": {
    "archery": {
      "readOnly": true,
      "url": "${ARCHERY_MCP_URL}",
      "headers": {
        "X-Archery-Token": "${ARCHERY_MCP_TOKEN}"
      },
      "prompts": {
        "role": "prompts/archery/role.md",
        "purpose": "prompts/archery/purpose.md",
        "workflow": "prompts/archery/workflow.md",
        "safety": "prompts/archery/safety.md"
      }
    },
    "prometheus": {
      "readOnly": true,
      "url": "${PROMETHEUS_MCP_SSE_URL}",
      "optionalHeaders": {
        "${PROMETHEUS_MCP_API_KEY_HEADER}": "${PROMETHEUS_MCP_API_KEY}"
      },
      "prompts": {
        "role": "prompts/prometheus/role.md",
        "purpose": "prompts/prometheus/purpose.md",
        "workflow": "prompts/prometheus/workflow.md",
        "safety": "prompts/prometheus/safety.md"
      },
      "toolPolicies": {
        "health_check": {
          "capability": "catalog",
          "fixedArguments": {}
        },
        "execute_query": {
          "capability": "catalog",
          "fixedArguments": {}
        },
        "execute_range_query": {
          "capability": "range_query",
          "startArgument": "start",
          "endArgument": "end",
          "timestampEncoding": "rfc3339",
          "fixedArguments": {}
        },
        "list_metrics": {
          "capability": "catalog",
          "fixedArguments": {}
        },
        "get_metric_metadata": {
          "capability": "catalog",
          "fixedArguments": {}
        },
        "get_targets": {
          "capability": "target_discovery",
          "fixedArguments": {}
        }
      }
    }
  }
}
