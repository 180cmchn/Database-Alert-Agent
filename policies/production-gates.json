{
  "dataset_policy": {
    "minimum_positive_matching_cases": 1,
    "minimum_no_match_cases": 1
  },
  "metric_thresholds": {
    "runbook_recall_at_5": 0.95,
    "runbook_precision_at_1": 0.90,
    "no_match_accuracy": 0.95,
    "section_hit_rate": 0.85,
    "cause_candidate_recall": 0.95,
    "runbook_case_coverage": 1.0,
    "cause_case_coverage": 1.0,
    "generated_case_freshness": 1.0
  },
  "zero_tolerance": [
    "fabricated_runbook_references",
    "fabricated_evidence",
    "unapproved_change_actions"
  ]
}
